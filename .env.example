# Copy to .env (or export directly) before running the pipeline.

# Gemini API key - enables embeddings, cluster summaries and the two semantic
# relevance sub-scores. Without it the pipeline still runs end to end using
# local lexical fallbacks, and every log line says which mode produced a result.
GEMINI_API_KEY=

# Optional: DEBUG surfaces every grouping and clustering similarity decision.
R2C_LOG_LEVEL=INFO

# Free Gemini tier allows 15 requests/minute; set to 0 on a paid tier.
GEMINI_MAX_REQUESTS_PER_MINUTE=14
# Composite score (0-100) a topic needs to qualify for content generation.
R2C_MIN_TREND_SCORE=50

# Image generation: Cloudflare Workers AI, no GPU needed. Free daily allocation,
# then pay-as-you-go. Account ID: Cloudflare dashboard. Token: My Profile >
# API Tokens > Create Token > "Workers AI" template.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# FLUX.2 Klein 4B renders each AIDA stage at its own aspect ratio
# (awareness 16:9, interest 1:1, desire 4:5, action 9:16).
# @cf/black-forest-labs/flux-1-schnell also works but is square-only.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Autonomous crawler (python -m web_crawler). All optional.
# Reddit is used only with an app-only OAuth client ("script" or "web" app) from
# https://www.reddit.com/prefs/apps - anonymous Reddit JSON access is blocked.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube Data API v3 key (optional): https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
CRAWL_TRENDS_GEOS=US,IN
CRAWL_MAX_TRENDING_QUERIES=8
CRAWL_MAX_REQUESTS=600
CRAWL_MAX_CONCURRENCY=8
CRAWL_MAX_REQUESTS_PER_MINUTE=120
CRAWL_LINK_DEPTH=1
# Gemini relevance gate: crawled records scoring below this (0-100) are dropped.
CRAWL_MIN_AI_RELEVANCE=50
# Article text kept per page for the content stage (Gate 2 embeds only the lead).
CRAWL_MAX_ARTICLE_CHARS=8000
